<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Centered within the 108dp canvas, perfectly fitted inside the 66dp circular mask -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.94"
        android:scaleY="0.94">

        <!-- 1. Soft Ground Shadow under Both Dice -->
        <path
            android:fillColor="#22000000"
            android:pathData="M 28,74.5 A 26,4.5 0 1,0 80,74.5 A 26,4.5 0 1,0 28,74.5 Z" />

        <!-- 2. DIE 1: Left Background Die (Centered at X=42.0, Y=48.0, Rotated -18°, 5 Pips) -->
        <group
            android:pivotX="42.0"
            android:pivotY="48.0"
            android:rotation="-18">

            <!-- Die 1 Body (30x30 with 6.5dp corner radius) -->
            <path
                android:pathData="M 33.5,33.0 L 50.5,33.0 C 53.8,33.0 56.5,35.7 56.5,39.0 L 56.5,56.0 C 56.5,59.3 53.8,62.0 50.5,62.0 L 33.5,62.0 C 30.2,62.0 27.5,59.3 27.5,56.0 L 27.5,39.0 C 27.5,35.7 30.2,33.0 33.5,33.0 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="27.5"
                        android:startY="33.0"
                        android:endX="56.5"
                        android:endY="62.0"
                        android:type="linear">
                        <item android:offset="0.0" android:color="#F8FAFC" />
                        <item android:offset="0.7" android:color="#EEF2FF" />
                        <item android:offset="1.0" android:color="#E0E7FF" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Die 1 Wider Boundary Stroke (1.8dp width for clear definition against white background) -->
            <path
                android:strokeColor="#64748B"
                android:strokeWidth="1.8"
                android:pathData="M 33.5,33.0 L 50.5,33.0 C 53.8,33.0 56.5,35.7 56.5,39.0 L 56.5,56.0 C 56.5,59.3 53.8,62.0 50.5,62.0 L 33.5,62.0 C 30.2,62.0 27.5,59.3 27.5,56.0 L 27.5,39.0 C 27.5,35.7 30.2,33.0 33.5,33.0 Z" />

            <!-- 5 Indigo Pips (#3730A3) -->
            <!-- Center Pip -->
            <path
                android:fillColor="#3730A3"
                android:pathData="M 42.0,48.0 m -2.5,0 a 2.5,2.5 0 1,0 5.0,0 a 2.5,2.5 0 1,0 -5.0,0" />
            <!-- Top-Left Pip -->
            <path
                android:fillColor="#3730A3"
                android:pathData="M 33.6,39.6 m -2.3,0 a 2.3,2.3 0 1,0 4.6,0 a 2.3,2.3 0 1,0 -4.6,0" />
            <!-- Top-Right Pip -->
            <path
                android:fillColor="#3730A3"
                android:pathData="M 50.4,39.6 m -2.3,0 a 2.3,2.3 0 1,0 4.6,0 a 2.3,2.3 0 1,0 -4.6,0" />
            <!-- Bottom-Left Pip -->
            <path
                android:fillColor="#3730A3"
                android:pathData="M 33.6,56.4 m -2.3,0 a 2.3,2.3 0 1,0 4.6,0 a 2.3,2.3 0 1,0 -4.6,0" />
            <!-- Bottom-Right Pip -->
            <path
                android:fillColor="#3730A3"
                android:pathData="M 50.4,56.4 m -2.3,0 a 2.3,2.3 0 1,0 4.6,0 a 2.3,2.3 0 1,0 -4.6,0" />
        </group>

        <!-- 3. DIE 2: Right Foreground Die (Centered at X=64.0, Y=54.0, Rotated +35°, 3 Diagonal Pips) -->
        <group
            android:pivotX="64.0"
            android:pivotY="54.0"
            android:rotation="35">

            <!-- Die 2 Cast Shadow onto Die 1 and Background -->
            <path
                android:fillColor="#22000000"
                android:pathData="M 53.5,41.0 L 70.5,41.0 C 73.8,41.0 76.5,43.7 76.5,47.0 L 76.5,64.0 C 76.5,67.3 73.8,70.0 70.5,70.0 L 53.5,70.0 C 50.2,70.0 47.5,67.3 47.5,64.0 L 47.5,47.0 C 47.5,43.7 50.2,41.0 53.5,41.0 Z" />

            <!-- Die 2 Body (30x30 with 6.5dp corner radius, Radiant White) -->
            <path
                android:pathData="M 55.5,39.0 L 72.5,39.0 C 75.8,39.0 78.5,41.7 78.5,45.0 L 78.5,62.0 C 78.5,65.3 75.8,68.0 72.5,68.0 L 55.5,68.0 C 52.2,68.0 49.5,65.3 49.5,62.0 L 49.5,45.0 C 49.5,41.7 52.2,39.0 55.5,39.0 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="49.5"
                        android:startY="39.0"
                        android:endX="78.5"
                        android:endY="68.0"
                        android:type="linear">
                        <item android:offset="0.0" android:color="#FFFFFF" />
                        <item android:offset="0.85" android:color="#FAFAFA" />
                        <item android:offset="1.0" android:color="#F1F5F9" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Die 2 Wider Boundary Stroke (1.8dp width in dark slate for strong definition) -->
            <path
                android:strokeColor="#334155"
                android:strokeWidth="1.8"
                android:pathData="M 55.5,39.0 L 72.5,39.0 C 75.8,39.0 78.5,41.7 78.5,45.0 L 78.5,62.0 C 78.5,65.3 75.8,68.0 72.5,68.0 L 55.5,68.0 C 52.2,68.0 49.5,65.3 49.5,62.0 L 49.5,45.0 C 49.5,41.7 52.2,39.0 55.5,39.0 Z" />

            <!-- 3 Diagonal Electric Indigo Pips (#4338CA) -->
            <!-- Top-Left Pip -->
            <path
                android:fillColor="#4338CA"
                android:pathData="M 55.6,45.6 m -2.6,0 a 2.6,2.6 0 1,0 5.2,0 a 2.6,2.6 0 1,0 -5.2,0" />

            <!-- Center Pip -->
            <path
                android:fillColor="#4338CA"
                android:pathData="M 64.0,54.0 m -2.6,0 a 2.6,2.6 0 1,0 5.2,0 a 2.6,2.6 0 1,0 -5.2,0" />

            <!-- Bottom-Right Pip -->
            <path
                android:fillColor="#4338CA"
                android:pathData="M 72.4,62.4 m -2.6,0 a 2.6,2.6 0 1,0 5.2,0 a 2.6,2.6 0 1,0 -5.2,0" />
        </group>

    </group>

</vector>
