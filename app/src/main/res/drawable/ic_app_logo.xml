<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Ambient Shadow -->
    <path
        android:fillColor="#30000000"
        android:pathData="M 12,18 C 12,10 18,4 26,4 L 70,4 C 78,4 84,10 84,18 L 84,82 C 84,90 78,96 70,96 L 26,96 C 18,96 12,90 12,82 Z" />

    <!-- Squircle Badge Base Container with Indigo/Violet Gradient -->
    <path
        android:pathData="M 10,16 C 10,8 16,2 24,2 L 72,2 C 80,2 86,8 86,16 L 86,80 C 86,88 80,94 72,94 L 24,94 C 16,94 10,88 10,80 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="2"
                android:endX="86"
                android:endY="94"
                android:type="linear">
                <item android:offset="0.0" android:color="#1E1B4B" />
                <item android:offset="0.5" android:color="#312E81" />
                <item android:offset="1.0" android:color="#4338CA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Indigo Rim -->
    <path
        android:strokeColor="#6366F1"
        android:strokeWidth="1.2"
        android:pathData="M 10,16 C 10,8 16,2 24,2 L 72,2 C 80,2 86,8 86,16 L 86,80 C 86,88 80,94 72,94 L 24,94 C 16,94 10,88 10,80 Z" />

    <!-- Ambient Glow Flare -->
    <path
        android:pathData="M48,44m-28,0a28,28 0 1,0 56,0a28,28 0 1,0 -56,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="48"
                android:centerY="44"
                android:gradientRadius="28"
                android:type="radial">
                <item android:offset="0.0" android:color="#40818CF8" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- DIE 1: Left Background Die (Tilted -12 degrees, 5 Pips) -->
    <group
        android:pivotX="38"
        android:pivotY="44"
        android:rotation="-12">

        <path
            android:pathData="M 24,30 C 24,26 27,22 32,22 L 44,22 C 49,22 52,26 52,30 L 52,52 C 52,56 49,60 44,60 L 32,60 C 27,60 24,56 24,52 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="24"
                    android:startY="22"
                    android:endX="52"
                    android:endY="60"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#EEF2FF" />
                    <item android:offset="1.0" android:color="#C7D2FE" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:strokeColor="#818CF8"
            android:strokeWidth="1.0"
            android:pathData="M 24,30 C 24,26 27,22 32,22 L 44,22 C 49,22 52,26 52,30 L 52,52 C 52,56 49,60 44,60 L 32,60 C 27,60 24,56 24,52 Z" />

        <!-- 5 Pips -->
        <path android:fillColor="#3730A3" android:pathData="M 38,41 m -2.5,0 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0" />
        <path android:fillColor="#3730A3" android:pathData="M 31,30 m -2.3,0 a 2.3,2.3 0 1,0 4.6,0 a 2.3,2.3 0 1,0 -4.6,0" />
        <path android:fillColor="#3730A3" android:pathData="M 45,30 m -2.3,0 a 2.3,2.3 0 1,0 4.6,0 a 2.3,2.3 0 1,0 -4.6,0" />
        <path android:fillColor="#3730A3" android:pathData="M 31,52 m -2.3,0 a 2.3,2.3 0 1,0 4.6,0 a 2.3,2.3 0 1,0 -4.6,0" />
        <path android:fillColor="#3730A3" android:pathData="M 45,52 m -2.3,0 a 2.3,2.3 0 1,0 4.6,0 a 2.3,2.3 0 1,0 -4.6,0" />
    </group>

    <!-- DIE 2: Right Foreground Die (Tilted +10 degrees, 3 Diagonal Pips) -->
    <group
        android:pivotX="58"
        android:pivotY="52"
        android:rotation="10">

        <!-- Cast shadow -->
        <path
            android:fillColor="#35000000"
            android:pathData="M 43,39 C 43,35 46,31 51,31 L 65,31 C 70,31 73,35 73,39 L 73,63 C 73,67 70,71 65,71 L 51,71 C 46,71 43,67 43,63 Z" />

        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 42,36 C 42,32 45,28 50,28 L 64,28 C 69,28 72,32 72,36 L 72,60 C 72,64 69,68 64,68 L 50,68 C 45,68 42,64 42,60 Z" />

        <path
            android:strokeColor="#CBD5E1"
            android:strokeWidth="1.0"
            android:pathData="M 42,36 C 42,32 45,28 50,28 L 64,28 C 69,28 72,32 72,36 L 72,60 C 72,64 69,68 64,68 L 50,68 C 45,68 42,64 42,60 Z" />

        <!-- 3 Pips -->
        <path android:fillColor="#4F46E5" android:pathData="M 49,36 m -2.6,0 a 2.6,2.6 0 1,0 5.2,0 a 2.6,2.6 0 1,0 -5.2,0" />
        <path android:fillColor="#4F46E5" android:pathData="M 57,48 m -2.6,0 a 2.6,2.6 0 1,0 5.2,0 a 2.6,2.6 0 1,0 -5.2,0" />
        <path android:fillColor="#4F46E5" android:pathData="M 65,60 m -2.6,0 a 2.6,2.6 0 1,0 5.2,0 a 2.6,2.6 0 1,0 -5.2,0" />
    </group>

    <!-- Sparkle -->
    <path
        android:fillColor="#FBBF24"
        android:pathData="M 72,18 L 73.5,21.5 L 77,23 L 73.5,24.5 L 72,28 L 70.5,24.5 L 67,23 L 70.5,21.5 Z" />

</vector>
