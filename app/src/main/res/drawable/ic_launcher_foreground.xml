<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Soft Ambient Ground Shadow under 3D Cube -->
    <path
        android:fillColor="#38000000"
        android:pathData="M 30,78 A 24,7 0 1,0 78,78 A 24,7 0 1,0 30,78 Z" />

    <!-- 2. Back Segment of the Orbital Energy Ring -->
    <path
        android:strokeColor="#4D818CF8"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:pathData="M 27,53 C 25,41 36,29 52,27" />

    <!-- 3. ISOMETRIC 3D LUCKY CUBE -->

    <!-- A. LEFT FACE (Royal Sapphire/Indigo) -->
    <path
        android:pathData="M 34,44 L 54,55 L 54,77 L 34,66 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="44"
                android:endX="54"
                android:endY="77"
                android:type="linear">
                <item android:offset="0.0" android:color="#4F46E5" />
                <item android:offset="0.6" android:color="#3730A3" />
                <item android:offset="1.0" android:color="#1E1B4B" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Left Face Subtle Chamfer Outline -->
    <path
        android:strokeColor="#40818CF8"
        android:strokeWidth="0.8"
        android:pathData="M 34,44 L 54,55 L 54,77 L 34,66 Z" />

    <!-- Left Face 3 Luminous Pips (Isometric Diagonal) -->
    <!-- Pip 1 -->
    <path
        android:fillColor="#EEF2FF"
        android:pathData="M 39,52m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 39,52m-1.2,0a1.2,1.2 0 1,1 2.4,0a1.2,1.2 0 1,1 -2.4,0" />
    <!-- Pip 2 (Center) -->
    <path
        android:fillColor="#EEF2FF"
        android:pathData="M 44,60m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 44,60m-1.2,0a1.2,1.2 0 1,1 2.4,0a1.2,1.2 0 1,1 -2.4,0" />
    <!-- Pip 3 -->
    <path
        android:fillColor="#EEF2FF"
        android:pathData="M 49,68m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 49,68m-1.2,0a1.2,1.2 0 1,1 2.4,0a1.2,1.2 0 1,1 -2.4,0" />

    <!-- B. RIGHT FACE (Vibrant Magenta/Amethyst Violet) -->
    <path
        android:pathData="M 54,55 L 74,44 L 74,66 L 54,77 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="55"
                android:endX="74"
                android:endY="66"
                android:type="linear">
                <item android:offset="0.0" android:color="#7C3AED" />
                <item android:offset="0.65" android:color="#6D28D9" />
                <item android:offset="1.0" android:color="#4C1D95" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Right Face Subtle Chamfer Outline -->
    <path
        android:strokeColor="#40C084FC"
        android:strokeWidth="0.8"
        android:pathData="M 54,55 L 74,44 L 74,66 L 54,77 Z" />

    <!-- Right Face 2 Luminous Pips -->
    <!-- Pip 1 -->
    <path
        android:fillColor="#FDF4FF"
        android:pathData="M 60,58m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 60,58m-1.2,0a1.2,1.2 0 1,1 2.4,0a1.2,1.2 0 1,1 -2.4,0" />
    <!-- Pip 2 -->
    <path
        android:fillColor="#FDF4FF"
        android:pathData="M 68,62m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 68,62m-1.2,0a1.2,1.2 0 1,1 2.4,0a1.2,1.2 0 1,1 -2.4,0" />

    <!-- C. TOP FACE (Radiant Ice/Lavender Gradient with Specular Sheen) -->
    <path
        android:pathData="M 54,33 L 74,44 L 54,55 L 34,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="33"
                android:endX="54"
                android:endY="55"
                android:type="linear">
                <item android:offset="0.0" android:color="#F5F3FF" />
                <item android:offset="0.4" android:color="#C7D2FE" />
                <item android:offset="1.0" android:color="#818CF8" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Top Face Specular Highlight Edge -->
    <path
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="1.2"
        android:pathData="M 34,44 L 54,33 L 74,44" />

    <!-- Top Face Center Fortune Star Pip (Golden Embossed Emblem) -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M 54,39 L 55.4,42.5 L 59,44 L 55.4,45.5 L 54,49 L 52.6,45.5 L 49,44 L 52.6,42.5 Z" />
    <path
        android:fillColor="#FEF08A"
        android:pathData="M 54,40.5 L 55,43 L 57.5,44 L 55,45 L 54,47.5 L 53,45 L 50.5,44 L 53,43 Z" />

    <!-- 4. Front Dynamic Orbital Energy Swoosh (Wrapping around front of cube) -->
    <path
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M 26,62 C 34,79 58,84 75,74 C 82,70 85,62 84,51 C 83.5,44 79.5,37 76,32">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="62"
                android:endX="76"
                android:endY="32"
                android:type="linear">
                <item android:offset="0.0" android:color="#06B6D4" />
                <item android:offset="0.45" android:color="#38BDF8" />
                <item android:offset="0.85" android:color="#FBBF24" />
                <item android:offset="1.0" android:color="#FEF08A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mini Orbital Glow Particle -->
    <path
        android:fillColor="#FEF08A"
        android:pathData="M 76,32m-1.5,0a1.5,1.5 0 1,1 3,0a1.5,1.5 0 1,1 -3,0" />

    <!-- 5. Brilliant Fortune Sparkle Burst (Top Right Vertex) -->
    <!-- Soft Ambient Halo -->
    <path
        android:fillColor="#33F59E0B"
        android:pathData="M 78,28m-7,0a7,7 0 1,1 14,0a7,7 0 1,1 -14,0" />
    <!-- 4-Point Gold Star -->
    <path
        android:fillColor="#FBBF24"
        android:pathData="M 78,20 L 79.8,26.2 L 86,28 L 79.8,29.8 L 78,36 L 76.2,29.8 L 70,28 L 76.2,26.2 Z" />
    <!-- Pure White Diamond Core -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 78,23.5 L 79.2,27 L 82.5,28 L 79.2,29 L 78,32.5 L 76.8,29 L 73.5,28 L 76.8,27 Z" />

    <!-- 6. Secondary Ambient Sparkle (Left side) -->
    <path
        android:fillColor="#A5B4FC"
        android:pathData="M 28,34 L 29.2,36.8 L 32,38 L 29.2,39.2 L 28,42 L 26.8,39.2 L 24,38 L 26.8,36.8 Z" />

</vector>
