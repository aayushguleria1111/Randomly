<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Clean Solid White Background without any outer boundary stroke -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 12,18 C 12,10 18,4 26,4 L 70,4 C 78,4 84,10 84,18 L 84,82 C 84,90 78,96 70,96 L 26,96 C 18,96 12,90 12,82 Z" />

    <!-- Centered Two Dice Group (Canvas center is 48, 48) -->
    <group
        android:pivotX="48"
        android:pivotY="48"
        android:scaleX="0.88"
        android:scaleY="0.88">

        <!-- Soft Ground Shadow -->
        <path
            android:fillColor="#20000000"
            android:pathData="M 22,69 A 24,4.2 0 1,0 74,69 A 24,4.2 0 1,0 22,69 Z" />

        <!-- DIE 1 (Centered at 37, 42, rotated -18°, 5 pips) -->
        <group
            android:pivotX="37"
            android:pivotY="42"
            android:rotation="-18">

            <path
                android:pathData="M 29,28 L 45,28 C 48.2,28 50.8,30.6 50.8,33.8 L 50.8,50.2 C 50.8,53.4 48.2,56 45,56 L 29,56 C 25.8,56 23.2,53.4 23.2,50.2 L 23.2,33.8 C 23.2,30.6 25.8,28 29,28 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="23"
                        android:startY="28"
                        android:endX="51"
                        android:endY="56"
                        android:type="linear">
                        <item android:offset="0.0" android:color="#F8FAFC" />
                        <item android:offset="1.0" android:color="#E0E7FF" />
                    </gradient>
                </aapt:attr>
            </path>
            <!-- Wider boundary stroke for Die 1 -->
            <path
                android:strokeColor="#64748B"
                android:strokeWidth="1.8"
                android:pathData="M 29,28 L 45,28 C 48.2,28 50.8,30.6 50.8,33.8 L 50.8,50.2 C 50.8,53.4 48.2,56 45,56 L 29,56 C 25.8,56 23.2,53.4 23.2,50.2 L 23.2,33.8 C 23.2,30.6 25.8,28 29,28 Z" />

            <!-- 5 Pips -->
            <path android:fillColor="#3730A3" android:pathData="M 37,42 m -2.4,0 a 2.4,2.4 0 1,0 4.8,0 a 2.4,2.4 0 1,0 -4.8,0" />
            <path android:fillColor="#3730A3" android:pathData="M 29.2,34.2 m -2.2,0 a 2.2,2.2 0 1,0 4.4,0 a 2.2,2.2 0 1,0 -4.4,0" />
            <path android:fillColor="#3730A3" android:pathData="M 44.8,34.2 m -2.2,0 a 2.2,2.2 0 1,0 4.4,0 a 2.2,2.2 0 1,0 -4.4,0" />
            <path android:fillColor="#3730A3" android:pathData="M 29.2,49.8 m -2.2,0 a 2.2,2.2 0 1,0 4.4,0 a 2.2,2.2 0 1,0 -4.4,0" />
            <path android:fillColor="#3730A3" android:pathData="M 44.8,49.8 m -2.2,0 a 2.2,2.2 0 1,0 4.4,0 a 2.2,2.2 0 1,0 -4.4,0" />
        </group>

        <!-- DIE 2 (Centered at 58, 48, rotated +35°, 3 pips) -->
        <group
            android:pivotX="58"
            android:pivotY="48"
            android:rotation="35">

            <!-- Shadow onto Die 1 -->
            <path
                android:fillColor="#22000000"
                android:pathData="M 48,36 L 64,36 C 67.2,36 69.8,38.6 69.8,41.8 L 69.8,58.2 C 69.8,61.4 67.2,64 64,64 L 48,64 C 44.8,64 42.2,61.4 42.2,58.2 L 42.2,41.8 C 42.2,38.6 44.8,36 48,36 Z" />

            <path
                android:pathData="M 50,34 L 66,34 C 69.2,34 71.8,36.6 71.8,39.8 L 71.8,56.2 C 71.8,59.4 69.2,62 66,62 L 50,62 C 46.8,62 44.2,59.4 44.2,56.2 L 44.2,39.8 C 44.2,36.6 46.8,34 50,34 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="44"
                        android:startY="34"
                        android:endX="72"
                        android:endY="62"
                        android:type="linear">
                        <item android:offset="0.0" android:color="#FFFFFF" />
                        <item android:offset="1.0" android:color="#F8FAFC" />
                    </gradient>
                </aapt:attr>
            </path>
            <!-- Wider boundary stroke for Die 2 -->
            <path
                android:strokeColor="#334155"
                android:strokeWidth="1.8"
                android:pathData="M 50,34 L 66,34 C 69.2,34 71.8,36.6 71.8,39.8 L 71.8,56.2 C 71.8,59.4 69.2,62 66,62 L 50,62 C 46.8,62 44.2,59.4 44.2,56.2 L 44.2,39.8 C 44.2,36.6 46.8,34 50,34 Z" />

            <!-- 3 Pips -->
            <path android:fillColor="#4338CA" android:pathData="M 50.2,40.2 m -2.5,0 a 2.5,2.5 0 1,0 5.0,0 a 2.5,2.5 0 1,0 -5.0,0" />
            <path android:fillColor="#4338CA" android:pathData="M 58.0,48.0 m -2.5,0 a 2.5,2.5 0 1,0 5.0,0 a 2.5,2.5 0 1,0 -5.0,0" />
            <path android:fillColor="#4338CA" android:pathData="M 65.8,55.8 m -2.5,0 a 2.5,2.5 0 1,0 5.0,0 a 2.5,2.5 0 1,0 -5.0,0" />
        </group>

    </group>

</vector>
