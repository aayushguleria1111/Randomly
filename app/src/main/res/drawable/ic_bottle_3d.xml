    android:width="120dp"
    android:height="240dp"
    android:viewportWidth="100"
    android:viewportHeight="200">

    <!-- Ground Drop Shadow under Bottle Center -->
    <path
        android:fillColor="#30000000"
        android:pathData="M 32,192 A 18,6 0 1,0 68,192 A 18,6 0 1,0 32,192 Z" />

    <!-- Glass Bottle Silhouette / Outer Body Base -->
    <path
        android:pathData="M 46,18
                          L 54,18
                          C 55,18 56,19 56,21
                          L 56,24
                          C 57,24 58,25 58,27
                          C 58,29 57,30 56,30
                          L 55,60
                          C 55,75 75,85 75,105
                          L 75,178
                          C 75,188 70,194 62,194
                          L 38,194
                          C 30,194 25,188 25,178
                          L 25,105
                          C 25,85 45,75 45,60
                          L 44,30
                          C 43,30 42,29 42,27
                          C 42,25 43,24 44,24
                          L 44,21
                          C 44,19 45,18 46,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="25"
                android:startY="18"
                android:endX="75"
                android:endY="194"
                android:type="linear">
                <item android:offset="0.0" android:color="#0D9488" />
                <item android:offset="0.35" android:color="#0F766E" />
                <item android:offset="0.75" android:color="#115E59" />
                <item android:offset="1.0" android:color="#134E4A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Bottle Glass Rim Outline -->
    <path
        android:strokeColor="#602DD4BF"
        android:strokeWidth="1.2"
        android:pathData="M 46,18 L 54,18 C 55,18 56,19 56,21 L 56,24 C 57,24 58,25 58,27 C 58,29 57,30 56,30 L 55,60 C 55,75 75,85 75,105 L 75,178 C 75,188 70,194 62,194 L 38,194 C 30,194 25,188 25,178 L 25,105 C 25,85 45,75 45,60 L 44,30 C 43,30 42,29 42,27 C 42,25 43,24 44,24 L 44,21 C 44,19 45,18 46,18 Z" />

    <!-- 3D Cylindrical Core Depth Gradient -->
    <path
        android:pathData="M 32,105 L 68,105 L 68,178 C 68,185 64,190 58,190 L 42,190 C 36,190 32,185 32,178 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="145"
                android:endX="68"
                android:endY="145"
                android:type="linear">
                <item android:offset="0.0" android:color="#20000000" />
                <item android:offset="0.3" android:color="#00000000" />
                <item android:offset="0.7" android:color="#30FFFFFF" />
                <item android:offset="1.0" android:color="#40000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottle Neck Glass Reflection Specular Line -->
    <path
        android:strokeColor="#70FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M 47,32 L 47,60 C 47,70 33,83 31,105 L 31,176" />

    <!-- Secondary Soft Reflection on Right Side -->
    <path
        android:strokeColor="#25FFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 69,105 L 69,176" />

    <!-- Vintage Bottle Label (Wrap around middle body) -->
    <path
        android:pathData="M 27,118 L 73,118 C 74,118 74.5,119 74.5,120 L 74.5,152 C 74.5,153 74,154 73,154 L 27,154 C 26,154 25.5,153 25.5,152 L 25.5,120 C 25.5,119 26,118 27,118 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="118"
                android:endX="74"
                android:endY="154"
                android:type="linear">
                <item android:offset="0.0" android:color="#FEF3C7" />
                <item android:offset="0.5" android:color="#FDE68A" />
                <item android:offset="1.0" android:color="#F59E0B" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Label Border Rim -->
    <path
        android:strokeColor="#D97706"
        android:strokeWidth="1.0"
        android:pathData="M 28,120 L 72,120 L 72,152 L 28,152 Z" />

    <!-- Star Emblem on Label -->
    <path
        android:fillColor="#B45309"
        android:pathData="M 50,126 L 51.5,131 L 56.5,131.5 L 52.5,134.5 L 54,139.5 L 50,136.5 L 46,139.5 L 47.5,134.5 L 43.5,131.5 L 48.5,131 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 50,128 L 51,131.5 L 54.5,132 L 52,134 L 53,137.5 L 50,135.5 L 47,137.5 L 48,134 L 45.5,132 L 49,131.5 Z" />

    <!-- Label Decorative Filigree Lines -->
    <path
        android:strokeColor="#B45309"
        android:strokeWidth="0.8"
        android:strokeLineCap="round"
        android:pathData="M 33,144 L 67,144" />
    <path
        android:strokeColor="#B45309"
        android:strokeWidth="0.8"
        android:strokeLineCap="round"
        android:pathData="M 38,147 L 62,147" />

    <!-- Golden Metallic Cap / Cork at the Bottle Top -->
    <path
        android:pathData="M 45,6 L 55,6 C 56,6 57,7 57,8 L 57,18 L 43,18 L 43,8 C 43,7 44,6 45,6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="43"
                android:startY="6"
                android:endX="57"
                android:endY="18"
                android:type="linear">
                <item android:offset="0.0" android:color="#FDE047" />
                <item android:offset="0.4" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#B45309" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Cap Rim Ribs -->
    <path
        android:strokeColor="#78350F"
        android:strokeWidth="0.8"
        android:pathData="M 43,11 L 57,11 M 43,15 L 57,15" />

    <!-- Cap Highlight -->
    <path
        android:strokeColor="#A0FFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 46,8 L 46,17" />

    <!-- Directional Pointer Arrow (Glowing Arrow at the Bottle Tip for absolute clarity) -->
    <path
        android:fillColor="#FBBF24"
        android:pathData="M 50,0 L 53.5,5 L 46.5,5 Z" />

</vector>
